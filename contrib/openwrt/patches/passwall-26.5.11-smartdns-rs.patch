--- a/usr/share/passwall/app.sh
+++ b/usr/share/passwall/app.sh
@@ -1465,6 +1465,14 @@
 		dnsmasq_version=$(dnsmasq -v | grep -i "Dnsmasq version " | awk '{print $3}')
 		[ "$(expr $dnsmasq_version \>= 2.87)" == 0 ] && echolog "Dnsmasq版本低于2.87，有可能无法正常使用！！！"
 	}
+
+	# SmartDNS owns the client DNS port; redirect there without a dnsmasq copy.
+	if [ "${DNS_SHUNT}" = "smartdns" ] && [ "$(uci -q get smartdns.@smartdns[0].port)" = "53" ]; then
+		DNS_REDIRECT_PORT=53
+		set_cache_var "ACL_default_dns_port" "53"
+		echolog "  - DNS requests redirected directly to SmartDNS:53"
+		return 0
+	fi
 
 	local DNSMASQ_TUN_DNS=$(get_first_dns TUN_DNS 53 | sed -E 's/^\[([^]]+)\]:(.*)$/\1#\2/; t; s/^([^:]+):([0-9]+)$/\1#\2/')
 	local RUN_NEW_DNSMASQ=1
