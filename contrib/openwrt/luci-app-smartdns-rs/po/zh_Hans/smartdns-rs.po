msgid "SmartDNS-rs"
msgstr "SmartDNS-rs"

msgid "SmartDNS-rs Log"
msgstr "SmartDNS-rs 日志"

msgid "Back to SmartDNS-rs"
msgstr "返回 SmartDNS-rs"

msgid "Rust implementation of SmartDNS with OpenWrt procd, UCI, dnsmasq and nftables integration."
msgstr "SmartDNS 的 Rust 实现，已集成 OpenWrt procd、UCI、dnsmasq 和 nftables。"

msgid "Port 6053 is recommended with dnsmasq forwarding. Port 53 makes SmartDNS-rs the main DNS listener."
msgstr "推荐使用 6053 端口并由 dnsmasq 转发；使用 53 端口时 SmartDNS-rs 将成为主 DNS 监听器。"

msgid "Preserves existing dnsmasq settings and restores them when SmartDNS-rs stops."
msgstr "保留现有 dnsmasq 设置，并在 SmartDNS-rs 停止时恢复。"

msgid "Dnsmasq is not forwarding to SmartDNS-rs."
msgstr "Dnsmasq 未转发到 SmartDNS-rs。"

msgid "Please check the system log and validate the generated configuration."
msgstr "请检查系统日志并验证生成的配置。"

msgid "Validate Configuration"
msgstr "验证配置"

msgid "Configuration is valid."
msgstr "配置有效。"

msgid "Native Configuration"
msgstr "原生配置"

msgid "Supported modes are ping, tcp:PORT, http[:PORT], https[:PORT], and none."
msgstr "支持的模式为 ping、tcp:端口、http[:端口]、https[:端口] 和 none。"

msgid "NFT set format: #4:family#table#set,#6:family#table#set"
msgstr "NFT 集合格式：#4:协议族#表#集合,#6:协议族#表#集合"

msgid "Cache file must be /etc/smartdns/NAME.cache."
msgstr "缓存文件必须使用 /etc/smartdns/名称.cache。"

msgid "Log files must be directly under /var/log/smartdns/."
msgstr "日志文件必须直接位于 /var/log/smartdns/ 目录下。"

msgid "Default: ping,tcp:80,tcp:443. Tests address reachability in this order. Use none to disable response address speed checks."
msgstr "默认：ping,tcp:80,tcp:443，依次尝试这些方式检测地址连通性。选择 none 可关闭响应地址测速。"

msgid "First Ping returns after the first successful speed check. Fastest IP waits to compare addresses. Fastest Response returns the upstream answer without response address speed checks."
msgstr "首次测速成功即返回：尽快返回可达地址；最快 IP：等待测速并比较地址；最快响应：直接返回上游应答，不进行响应地址测速。"

msgid "Compares IPv4 and IPv6 reachability separately and may add DNS latency. Disable to return both families without this comparison."
msgstr "独立比较 IPv4 与 IPv6 的连通性，可能增加 DNS 延迟。关闭后不进行此比较，分别返回两类查询的结果。"

msgid "Worker Threads"
msgstr "工作线程数"

msgid "Cache Memory Budget"
msgstr "缓存内存预算"

msgid "Maximum Concurrent Queries"
msgstr "最大并发查询数"

msgid "Maximum Stale Lifetime"
msgstr "过期缓存最长保留秒数"

msgid "Stale Reply TTL"
msgstr "过期应答 TTL"

msgid "Expired Cache Refresh Interval"
msgstr "过期缓存刷新间隔（秒）"

