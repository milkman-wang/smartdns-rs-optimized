config smartdns
	option enabled '0'
	option port '6053'
	option auto_set_dnsmasq '1'
	option tcp_server '1'
	option ipv6_server '1'
	option bind_device '0'
	option speed_check_mode 'ping,tcp:80,tcp:443'
	option response_mode 'first-ping'
	option dualstack_ip_selection '1'
	option serve_expired '1'
	option cache_size '4096'
	option cache_persist '1'
	option resolve_local_hostnames '1'
	option force_https_soa '1'
	option log_level 'warn'
	option log_size '128K'
	option log_num '2'
	option log_file '/var/log/smartdns/smartdns.log'
	option enable_audit_log '0'

config domain-rule

config ip-rule
